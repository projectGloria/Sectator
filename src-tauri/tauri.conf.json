{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sectator",
  "version": "0.1.0-alpha.5",
  "identifier": "dev.gloria.sectator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sectator",
        "width": 1360,
        "height": 840,
        "minWidth": 900,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "center": true,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
